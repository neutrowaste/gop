# EasyPanel / Compose. Copie para .env e preencha as senhas (não versionar).

# Postgres (EasyPanel) — schema é criado no boot da API (Hibernate ddl-auto=update).
SPRING_DATASOURCE_URL=jdbc:postgresql://devpanel.neutrowaste.cloud:12012/bd_gop?sslmode=disable
SPRING_DATASOURCE_USERNAME=usr_bd_gop
SPRING_DATASOURCE_PASSWORD=

# Obrigatório em produção (>= 32 caracteres).
JWT_SECRET=

# Origens do Angular se a API for exposta em outro domínio.
# Com o compose padrão (nginx proxy /api) o mesmo origin basta.
GOP_CORS_ORIGINS=http://localhost:4200
# GOP_CORS_ORIGIN_PATTERNS=https://*.neutrowaste.cloud

# Seed do admin de plataforma no primeiro boot.
GOP_SEED_ADMIN_ENABLED=true
GOP_SEED_ADMIN_EMAIL=admin@gop.com
GOP_SEED_ADMIN_SENHA=Admin@Gop2026
GOP_SEED_ADMIN_NOME=Admin Plataforma GOP

# Só se o front e a API tiverem domínios separados (sem proxy nginx).
# GOP_API_URL=https://api.seudominio.com/api
